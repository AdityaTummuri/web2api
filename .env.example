# Web2API Independent Server Environment Configuration

# Server host and port binding (0.0.0.0 allows external network / server access)
HOST=0.0.0.0
PORT=8000

# Optional API Key authentication
# When set, all REST endpoints and WebSocket connections will require this key.
# Leave blank or commented out for open/local-only access.
# WEB2API_API_KEY=sk-w2a-live-sec-your-secret-key-here

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
