# Web2API Independent Server Environment Configuration

# Server host and port binding.
# 127.0.0.1 (default) = this device only. 0.0.0.0 = every network the device joins;
# the server refuses to bind a non-loopback address unless an API key is configured.
HOST=127.0.0.1
PORT=8000

# API key authentication. Keys come from this variable and/or api.txt
# (generate per-install random keys with: python3 web2api_keys.py generate).
# Once any key exists, every REST request and the extension WebSocket (?token=<key>) must use one.
# WEB2API_API_KEY=sk-w2a-live-your-own-random-key

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
