# Google Authentication Session (Contains sensitive credentials, cookies, and tokens)
.playwright_session/

# Python Virtual Environment
.venv/
env/
venv/
ENV/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd

# Diagnostic and log files
*.log
*.png
.pytest_cache/

# Node.js dependencies (extension)
extension/node_modules/

# Extension icons are needed by manifest.json (override the *.png rule above)
!extension/icons/
!extension/icons/*.png
