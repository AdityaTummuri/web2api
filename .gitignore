# Google Authentication Session (Contains sensitive credentials, cookies, and tokens)
.playwright_session/

# Python Virtual Environment
.venv/
env/
venv/
ENV/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Diagnostic and log files
*.log
*.png
.pytest_cache/

# Extension build artifacts
extension/dist/
*.xpi

# Node.js dependencies (extension)
extension/node_modules/

# Extension icons are needed by manifest.json (override the *.png rule above)
!extension/icons/
!extension/icons/*.png

# Per-install API keys (generated by install.sh / web2api_keys.py) - never commit
api.txt
.env
