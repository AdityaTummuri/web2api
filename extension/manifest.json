{
  "manifest_version": 2,
  "name": "Web2API Pro - Browser Chat to API Bridge",
  "version": "2.0.6",
  "description": "Transforms your active browser AI chat sessions (Gemini, ChatGPT, Claude) into a high-speed, local OpenAI-compatible API.",
  "browser_specific_settings": {
    "gecko": {
      "id": "web2api@web2api.local",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "parser.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Web2API Pro Console",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
